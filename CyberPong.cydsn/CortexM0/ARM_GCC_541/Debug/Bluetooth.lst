 793:Generated_Source\PSoC4/Bluetooth.c ****     * 
 794:Generated_Source\PSoC4/Bluetooth.c ****     *******************************************************************************/
 795:Generated_Source\PSoC4/Bluetooth.c ****     CYBLE_API_RESULT_T CyBle_GappStartAdvertisement(uint8 advertisingIntervalType)
 796:Generated_Source\PSoC4/Bluetooth.c ****     {
